{
  "name": "fly-vscode-extension",
  "displayName": "Fly Programming Language",
  "description": "Fly programming language support for Visual Studio Code: syntax highlighting, snippets, and language configuration for .fly files.",
  "version": "0.4.2",
  "publisher": "fly-lang",
  "icon": "fly_logo.png",
  "license": "Apache-2.0",
  "homepage": "https://flylang.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/fly-lang/vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/fly-lang/vscode-extension/issues"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "fly",
    "flylang",
    "fly-lang"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "walkthroughs": [
      {
        "id": "fly-getting-started",
        "title": "Get Started with Fly",
        "description": "Set up the Fly compiler, write your first program, and build and debug it.",
        "steps": [
          {
            "id": "select-compiler",
            "title": "Select the Fly compiler",
            "description": "Run **Fly: Select Compiler** to point the extension to your Fly installation. The status bar shows the active version once found.\n\n[Select Compiler](command:fly.selectCompiler)",
            "media": { "markdown": "media/first-file.md", "altText": "Compiler selector" },
            "completionEvents": ["onCommand:fly.selectCompiler"]
          },
          {
            "id": "first-file",
            "title": "Write your first Fly program",
            "description": "Create a `.fly` file and start typing — hover docs, completions, and syntax highlighting activate automatically.",
            "media": { "markdown": "media/first-file.md" }
          },
          {
            "id": "build-run",
            "title": "Build and run",
            "description": "Press **Ctrl+F5** to compile and run, **Ctrl+Shift+B** to build only, or **F5** to launch the debugger (uses the lldb-dap bundled with the Fly toolchain).",
            "media": { "markdown": "media/first-file.md" },
            "completionEvents": ["onCommand:fly.runFile", "onCommand:fly.buildFile"]
          },
          {
            "id": "project",
            "title": "Manage your project",
            "description": "Run **Fly: Init Project** to scaffold a `Manifest.fly`, then use **Fly: Build Project**, **Fly: Run Project** and **Fly: Add Dependency**.",
            "media": { "markdown": "media/first-file.md" },
            "completionEvents": ["onCommand:fly.pkgInit", "onCommand:fly.pkgBuild"]
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "fly",
        "aliases": [
          "Fly",
          "fly"
        ],
        "extensions": [
          ".fly",
          ".fly.h"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/fly-light.svg",
          "dark": "./icons/fly-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "fly",
        "scopeName": "source.fly",
        "path": "./syntaxes/fly.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "fly.selectCompiler",
        "title": "Fly: Select Compiler",
        "category": "Fly"
      },
      {
        "command": "fly.buildFile",
        "title": "Fly: Build File",
        "category": "Fly",
        "icon": "$(play)"
      },
      {
        "command": "fly.runFile",
        "title": "Fly: Run File",
        "category": "Fly",
        "icon": "$(run)"
      },
      {
        "command": "fly.debugFile",
        "title": "Fly: Debug File",
        "category": "Fly",
        "icon": "$(debug-alt)"
      },
      {
        "command": "fly.pkgInit",
        "title": "Fly: Init Project",
        "description": "Scaffold Manifest.fly and src/main.fly in the workspace root",
        "category": "Fly"
      },
      {
        "command": "fly.pkgBuild",
        "title": "Fly: Build Project",
        "description": "Build the project (incremental — only recompiles changed targets)",
        "category": "Fly",
        "icon": "$(play)"
      },
      {
        "command": "fly.pkgRun",
        "title": "Fly: Run Project",
        "category": "Fly",
        "icon": "$(run-above)"
      },
      {
        "command": "fly.pkgTest",
        "title": "Fly: Test Project",
        "category": "Fly"
      },
      {
        "command": "fly.pkgAdd",
        "title": "Fly: Add Dependency",
        "description": "Add a git dependency to Manifest.fly and re-lock",
        "category": "Fly"
      },
      {
        "command": "fly.pkgRemove",
        "title": "Fly: Remove Dependency",
        "description": "Drop a dependency from Manifest.fly and re-lock",
        "category": "Fly"
      },
      {
        "command": "fly.pkgWhy",
        "title": "Fly: Why Is This Dependency Here?",
        "description": "Explain why a package is in the dependency graph",
        "category": "Fly"
      },
      {
        "command": "fly.pkgSelectProfile",
        "title": "Fly: Select Profile",
        "category": "Fly"
      },
      {
        "command": "fly.pkgClean",
        "title": "Fly: Clean Project",
        "description": "Remove the profile's output directory and its incremental fingerprints",
        "category": "Fly"
      },
      {
        "command": "fly.pkgLock",
        "title": "Fly: Lock (Update Lock.fly)",
        "category": "Fly"
      },
      {
        "command": "fly.pkgRunCmd",
        "title": "Fly: Run Project Command",
        "category": "Fly"
      }
    ],
    "keybindings": [
      {
        "command": "fly.buildFile",
        "key": "ctrl+shift+b",
        "when": "editorLangId == fly && !(resourceFilename =~ /^[Mm]anifest\\.fly$/)"
      },
      {
        "command": "fly.buildFile",
        "key": "cmd+shift+b",
        "when": "editorLangId == fly && !(resourceFilename =~ /^[Mm]anifest\\.fly$/)"
      },
      {
        "command": "fly.runFile",
        "key": "ctrl+f5",
        "when": "editorLangId == fly"
      },
      {
        "command": "fly.runFile",
        "key": "cmd+f5",
        "when": "editorLangId == fly"
      },
      {
        "command": "fly.debugFile",
        "key": "f5",
        "when": "editorLangId == fly && !inDebugMode"
      },
      {
        "command": "fly.pkgBuild",
        "key": "ctrl+shift+b",
        "when": "resourceFilename =~ /^[Mm]anifest\\.fly$/"
      },
      {
        "command": "fly.pkgBuild",
        "key": "cmd+shift+b",
        "when": "resourceFilename =~ /^[Mm]anifest\\.fly$/"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "fly.debugFile",
          "when": "resourceLangId == fly && !(resourceFilename =~ /^[Mm]anifest\\.fly$/)",
          "group": "navigation@1"
        },
        {
          "command": "fly.runFile",
          "when": "resourceLangId == fly && !(resourceFilename =~ /^[Mm]anifest\\.fly$/)",
          "group": "navigation@2"
        },
        {
          "command": "fly.buildFile",
          "when": "resourceLangId == fly && !(resourceFilename =~ /^[Mm]anifest\\.fly$/)",
          "group": "navigation@3"
        },
        {
          "command": "fly.pkgBuild",
          "when": "resourceFilename =~ /^[Mm]anifest\\.fly$/",
          "group": "navigation@1"
        },
        {
          "command": "fly.pkgRun",
          "when": "resourceFilename =~ /^[Mm]anifest\\.fly$/",
          "group": "navigation@2"
        }
      ]
    },
    "breakpoints": [
      { "language": "fly" }
    ],
    "debuggers": [
      {
        "type": "fly",
        "label": "Fly Debug",
        "languages": ["fly"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the executable to debug."
              },
              "args": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Command-line arguments passed to the program.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Working directory of the program.",
                "default": "${workspaceFolder}"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "fly",
            "request": "launch",
            "name": "Fly: Debug File",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "cwd": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Fly: Launch and debug current file",
            "description": "Compile with --debug and launch under the lldb-dap bundled with the Fly toolchain.",
            "body": {
              "type": "fly",
              "request": "launch",
              "name": "Fly: Debug File",
              "program": "^\"\\${fileDirname}/\\${fileBasenameNoExtension}\"",
              "args": [],
              "cwd": "^\"\\${workspaceFolder}\""
            }
          }
        ]
      }
    ],
    "problemMatchers": [
      {
        "name": "fly",
        "owner": "fly",
        "fileLocation": ["absolute"],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+):\\s+(fatal error|error|warning|note|remark):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ],
    "taskDefinitions": [
      {
        "type": "fly",
        "required": ["task"],
        "properties": {
          "task": {
            "type": "string",
            "description": "The fly task to run (e.g. build)"
          }
        }
      }
    ],
    "snippets": [
      {
        "language": "fly",
        "path": "./snippets/fly.code-snippets"
      }
    ],
    "configuration": {
      "title": "Fly",
      "properties": {
        "fly.compilerPath": {
          "type": "string",
          "default": "fly",
          "description": "Path to the Fly compiler executable. Used to run live diagnostics on save."
        },
        "fly.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Run the Fly compiler on save and show errors and warnings as inline diagnostics. Fallback only: ignored while fly.enableLsp is on — the language server is then the single source of diagnostics."
        },
        "fly.lspPath": {
          "type": "string",
          "default": "",
          "description": "Path to the fly-lsp binary. Leave empty to auto-discover next to fly.compilerPath."
        },
        "fly.enableLsp": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Fly Language Server for semantic features (hover on symbols, go-to-definition, find references)."
        },
        "fly.buildArgs": {
          "type": "string",
          "default": "",
          "description": "Extra arguments appended to the fly compiler when running 'Fly: Build File', e.g. \"-O2\" or \"-o bin/myapp\"."
        },
        "fly.projectProfile": {
          "type": "string",
          "enum": ["", "release"],
          "enumDescriptions": [
            "debug — -O0, debug info, assertions on",
            "release — -O3, no debug info, assertions off"
          ],
          "default": "",
          "description": "Build profile used by the Fly: Build / Run / Test Project commands. Empty = debug. Only these two exist: the manifest reader does not consume the schema's 'profiles' field yet, so a custom profile name would change nothing."
        },
        "fly.projectForceRebuild": {
          "type": "boolean",
          "default": false,
          "description": "Pass --force to Fly: Build Project, bypassing the per-target fingerprint cache so every target is recompiled."
        },
        "fly.projectBuildArgs": {
          "type": "string",
          "default": "",
          "description": "Extra arguments appended to 'fly build', e.g. \"--target mybin\". Use fly.projectProfile to select the profile."
        },
        "fly.debugBuildArgs": {
          "type": "string",
          "default": "--debug",
          "description": "Extra compiler flags used by 'Fly: Debug File', e.g. \"--debug -O0\"."
        },
        "fly.enableWorkspaceDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Scan all .fly files in the workspace for errors at startup, not only files that are explicitly opened. Fallback only: ignored while fly.enableLsp is on."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "test": "npm run compile && node tests/unit.js",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish --oidc"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.0"
  }
}
