# TypeScript source — compiled to out/
src/
tsconfig.json

# Generator tooling (data/stdlib-completions.json IS packaged; its generator is not)
scripts/

# Unit tests (run by CI before packaging, not shipped)
tests/

# Build artefacts that don't belong in the package
out/**/*.js.map
*.vsix

# Node / npm
#
# node_modules/ must NOT be excluded: this extension is compiled with plain tsc,
# it is NOT bundled, so `vscode-languageclient` has to travel inside the .vsix or
# the lazy require() in src/lsp/client.ts fails at runtime and the language
# server never starts (the user only sees the "module not found" warning).
# vsce ships production dependencies only — devDependencies are pruned for it.
# Only re-add the exclusion together with a bundler (esbuild/webpack).
package-lock.json

# Version control
.git/
.gitignore
.github/

# IDE project files
.idea/
.vscode/

# Grammar specification (developer reference, not used by the runtime extension)
fly.ebnf
